# انسخي هذا الملف إلى .env وعدّلي القيم.
# تنبيه: كل متغير يبدأ بـ VITE_ يُضمَّن في ملفات JavaScript العامة للموقع (بما فيها كلمة مرور الإدارة).

VITE_BRAND_NAME=شغف
VITE_TAGLINE=تفاصيل تُصنع بكل حب وشغف
VITE_SITE_DESCRIPTION=شغف يقدم شموعاً مصنوعة يدوياً على شكل ورود وباقات وهدايا بتفاصيل ناعمة صُممت بكل حب وشغف.
VITE_SITE_URL=https://example.com
VITE_WHATSAPP_NUMBER=
VITE_INSTAGRAM_URL=
VITE_CURRENCY='$'
# إذا احتوت كلمة المرور على علامة $ اكتبيها كـ \$ (مثال: pa\$sword)، لأن Vite يفسّر $كلمة كمتغير.
VITE_ADMIN_USERNAME=
VITE_ADMIN_PASSWORD=
