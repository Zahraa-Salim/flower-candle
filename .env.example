# انسخي هذا الملف إلى .env وعدّلي القيم.
# المتغيرات التي تبدأ بـ VITE_ تُضمَّن في ملفات JavaScript العامة للموقع؛ الباقي يُقرأ على الخادم فقط.

# ---------- الموقع (عام) ----------
VITE_BRAND_NAME=شغف
VITE_TAGLINE=تفاصيل تُصنع بكل حب وشغف
VITE_SITE_DESCRIPTION=شغف يقدم شموعاً مصنوعة يدوياً على شكل ورود وباقات وهدايا بتفاصيل ناعمة صُممت بكل حب وشغف.
VITE_SITE_URL=https://example.com
# رقم واتساب بالصيغة الدولية بدون + أو مسافات. `npm run build` يتوقف إذا كان فارغاً أو ليس رقماً من 8 إلى 15 خانة.
VITE_WHATSAPP_NUMBER=
VITE_INSTAGRAM_URL=
VITE_CURRENCY='$'

# مصدر البيانات: api (قاعدة PostgreSQL عبر الخادم، الافتراضي) أو local (تخزين تجريبي في المتصفح فقط)
VITE_DATA_SOURCE=api
# اتركيه فارغاً عندما يُقدَّم الـ API من نفس الموقع (npm start). مثال عند فصله: https://api.example.com
VITE_API_URL=

# ---------- الخادم (لا يُضمَّن في الموقع) ----------
# سلسلة اتصال PostgreSQL (Neon: من لوحة التحكم، مع sslmode=require)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# بيانات دخول لوحة الإدارة — تُفحص على الخادم. إذا احتوت كلمة المرور على $ اكتبيها كـ \$
ADMIN_USERNAME=
ADMIN_PASSWORD=
# سرّ عشوائي طويل لتوقيع جلسات الإدارة (مثلاً: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=
# منفذ خادم الإنتاج (npm start)
PORT=3000
# فقط إذا كان الـ API على نطاق مختلف عن الموقع: النطاقات المسموح لها، مفصولة بفواصل
CORS_ORIGIN=

# ---------- الوضع التجريبي فقط (VITE_DATA_SOURCE=local) ----------
# VITE_ADMIN_USERNAME=admin
# VITE_ADMIN_PASSWORD=change-me
